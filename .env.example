# Copy to .env and fill in. Matches the Postgres container in compose.yaml.
DATABASE_URL="postgresql://flavorforge:password@localhost:5432/flavorforge_dev"

# Signs session cookies. Use a long random string.
JWT_SECRET="change-me"

# Optional: Google Places proxy behind the "Find nearby" map
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Optional: only for prisma/batch_predict_substitutes.ts (Gemini)
GOOGLE_GENERATIVE_AI_API_KEY=""

# Optional: set to 1 to log every SQL statement Prisma runs
PRISMA_LOG_QUERIES=""
